### iot agent json - Delete service created in init.sh

DELETE http://localhost:4041/iot/services?resource=/iot/json&apikey=waterLevelApiKey HTTP/1.1
fiware-service: smartcity
fiware-servicepath: /

### iot agent json - register new service waterLevelApiKey

POST http://localhost:4041/iot/services HTTP/1.1
Content-Type: application/json
fiware-service: smartcity
fiware-servicepath: /

{
    "services": [
    {
        "apikey": "waterLevelApiKey",
        "cbroker": "http://localhost:9090",
        "entity_type": "water-level-sensor",
        "resource": "/iot/json",
        "attributes": [
          {"object_id": "address", "name": "address", "type": "String"},
          {"object_id": "levelId", "name": "levelId", "type": "String"},
          {"object_id": "name", "name": "name", "type": "String"},
          {"object_id": "location", "name": "location", "type": "GeoProperty"},
          {"object_id": "dateWaterLevel", "name": "dateWaterLevel", "type": "String"},
          {"object_id": "waterLevel", "name": "waterLevel", "type": "Float", "expression": "waterLevel*0.01"},
          {"object_id": "waterLevelWarning", "name": "waterLevelWarning", "type": "String"},
          {"object_id": "dateDischarge", "name": "dateDischarge", "type": "String"},
          {"object_id": "discharge", "name": "discharge", "type": "Float", "expression": "discharge*0.01"},
          {"object_id": "dischargeWarningLevel", "name": "dischargeWarningLevel", "type": "String"},
          {"object_id": "hasCurrentWaterLevel", "name": "hasCurrentWaterLevel", "type": "Boolean"},
          {"object_id": "hasCurrentDischarge", "name": "hasCurrentDischarge", "type": "Boolean"}    
      ]
    }
  ]
}

### iot agent json - register new device LEVEL10109

POST http://localhost:4041/iot/devices HTTP/1.1
Content-Type: application/json
fiware-service: smartcity
fiware-servicepath: /

{
  "devices": [
    {
      "device_id": "LEVEL10109",
      "entity_name": "urn:ngsi-ld:water-level-sensor:LEVEL10109",
      "entity_type": "water-level-sensor", 
      "transport": "HTTP"
    }
  ]
}

### iot agent json - get services


GET http://localhost:4041/iot/services
fiware-service: smartcity
fiware-servicepath: /


### iot agent json - get devices


GET http://localhost:4041/iot/devices
fiware-service: smartcity
fiware-servicepath: /


### scorpio context broker - Create Subscription

POST http://localhost:9090/ngsi-ld/v1/subscriptions/ HTTP/1.1
Content-Type: application/ld+json
NGSILD-Tenant: smartcity
NGSILD-Path: /

{
  "type": "Subscription",
  "entities": [
    {
      "type": "water-level-sensor"
    }
  ],
  "watchedAttributes": [
    "address",
    "levelId",
    "waterLevel",
    "waterLevelWarning"
  ],
  "notification": {
    "endpoint": {
      "uri": "http://quantumleap:8668/v2/notify",
      "accept": "application/json"
    },
    "format": "normalized"
  },
  "throttling": 1,
  "description": "Subscription to monitor changes in temperature and humidity for all devices.",
  "@context": [
    "http://context-hoster/ngsi-ld-core-context-v1.8.jsonld"
  ]
}


### scorpio context broker - Query subscriptions

GET http://localhost:9090/ngsi-ld/v1/subscriptions/ 
Link: <http://context-hoster/ngsi-ld-core-context-v1.8.jsonld>; rel="http://www.w3.org/ns/json-ld#context"
NGSILD-Tenant: smartcity
NGSILD-Path: /
Accept: application/ld+json

### Data mock - Send sensor data for device LEVEL10109

POST http://localhost:7896/iot/json?k=waterLevelApiKey&i=LEVEL10109 HTTP/1.1
Content-Type: application/json
NGSILD-Tenant: smartcity
NGSILD-Path: /

{
  "address": "test",
  "levelId": "10109",
  "waterLevel": "42",
  "waterLevelWarning": -1  
}


