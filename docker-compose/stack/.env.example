# Copy this file to .env and replace all placeholders before the first start.
# Values that contain a "$" (password hashes) must be put in single quotes.

# Domain used by Traefik for all public routes, e.g. grafana.example.com
DOMAIN=example.com
# Basic auth users for Traefik in htpasswd format, e.g. created with: htpasswd -nb admin <password>
TRAEFIK_BASIC_AUTH='admin:$apr1$change$me'

CONTEXT_URL=http://context-hoster/ngsi-ld-core-context-v1.8.jsonld
IOT_AGENT_PROPERTY_POST_URL=http://iot-agent-json:7896/iot/json
#ENVIRONMENT = dev or prod
ENVIRONMENT=dev
# true restores the latest backup on every start and replaces the current database content.
# Only set it to true for a one-time restore, then set it back to false.
RESTORE_ON=false

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GRAFANA_POSTGRES_USER=grafanareader
GRAFANA_POSTGRES_PASSWORD=change-me
GRAFANA_PLUGINS=esnet-matrix-panel
# Organization that anonymous viewers see. Dashboards and data source are provisioned into the first organization (Main Org.).
GRAFANA_ANONYMOUS_ORG_NAME=Main Org.

# Node-RED editor login, the password as bcrypt hash (see docs/node-red/README.md)
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD_HASH='$2b$08$change.me'

# Upload key (PASSWORD) of the Froggit weather stations, used as IoT Agent JSON API key
FROGGIT_API_KEY=example-froggit-key

# Air quality station (eLichens API)
ELICHENS_API_KEY=change-me
ELICHENS_STATION_ID=change-me

# Mailbox that receives the daily load profile CSV files
EMAIL_HOST=imap.example.com
EMAIL_USER=load-profiles@example.com
EMAIL_PASS=change-me

# External MQTT broker that receives the climate quarter data
CLIMATE_QUARTER_MQTT_URL=mqtts://mqtt.example.com
CLIMATE_QUARTER_MQTT_USER=change-me
CLIMATE_QUARTER_MQTT_PASSWORD=change-me
# API key of the IoT Agent UL service group for the climate quarter houses
CLIMATE_QUARTER_API_KEY=example-api-key

# The Things Network (TTN)
TTN_BROKER=eu1.cloud.thethings.network
TTN_PORT=1883

# LoRaWAN devices. APPLICATION_USER is the TTN application ID, APPLICATION_PASSWORD a TTN API key.
LORA_WEATHER_APPLICATION_USER=weather-app@ttn
LORA_WEATHER_APPLICATION_PASSWORD=change-me
LORA_WEATHER_DEV_EUI=0000000000000001
LORA_WEATHER_APP_EUI=0000000000000000
LORA_WEATHER_APP_KEY=00000000000000000000000000000000

LORA_PARKING_LOT_APPLICATION_USER=parking-lot-app@ttn
LORA_PARKING_LOT_APPLICATION_PASSWORD=change-me
LORA_PARKING_LOT_DEV_EUI=0000000000000002
LORA_PARKING_LOT_APP_EUI=0000000000000000
LORA_PARKING_LOT_APP_KEY=00000000000000000000000000000000

LORA_PARKING_BARRIER_APPLICATION_USER=parking-barrier-app@ttn
LORA_PARKING_BARRIER_APPLICATION_PASSWORD=change-me
LORA_PARKING_BARRIER_DEV_EUI=0000000000000003
LORA_PARKING_BARRIER_APP_EUI=0000000000000000
LORA_PARKING_BARRIER_APP_KEY=00000000000000000000000000000000
# TTN device ID of the parking barrier, used for downlinks (lower case)
LORA_PARKING_BARRIER_DEVICE_ID=parking-barrier-1

LORA_ZENNER_WASTE_APPLICATION_USER=wastebox-app@ttn
LORA_ZENNER_WASTE_APPLICATION_PASSWORD=change-me
LORA_ZENNER_WASTE_DEV_EUI=0000000000000004
LORA_ZENNER_WASTE_APP_EUI=0000000000000000
LORA_ZENNER_WASTE_APP_KEY=00000000000000000000000000000000

LORA_DRAGINO_WQS_APPLICATION_USER=water-quality-app@ttn
LORA_DRAGINO_WQS_APPLICATION_PASSWORD=change-me
LORA_DRAGINO_WQS_DEV_EUI=0000000000000005
LORA_DRAGINO_WQS_APP_EUI=0000000000000000
LORA_DRAGINO_WQS_APP_KEY=00000000000000000000000000000000

# MongoDB and Mongo Express
MONGO_USERNAME=root
MONGO_PASSWORD=change-me
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me

# Mosquitto MQTT broker of the stack
MOSQUITTO_USERNAME=admin
MOSQUITTO_PASSWORD=change-me

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# QuantumLeap and TimescaleDB
QUANTUMLEAP_DB_HOST=timescale-db-quantumleap
QUANTUMLEAP_DB=quantumleap
QUANTUMLEAP_DB_USER=quantumleap
QUANTUMLEAP_DB_PASSWORD=change-me
QUANTUMLEAP_DB_BACKUP_USER=backup_user
QUANTUMLEAP_DB_BACKUP_PASSWORD=change-me

# Scorpio context broker: Java memory and database. The lab server runs with -Xms12g -Xmx12g.
SCORPIO_JAVA_OPTS=-Xms512m -Xmx2g
SCORPIO_DB=scorpio
SCORPIO_DB_USER=scorpio
SCORPIO_DB_PASSWORD=change-me
