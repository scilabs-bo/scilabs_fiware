{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "ngsi-ld": "http://context-hoster/ngsi-ld-core-context-v1.8.jsonld#",
    "geojson": "http://context-hoster/geojson/geojson.jsonld#",
    "id": "@id",
    "type": "@type",
    "distance_cm": {
      "@id": "ngsi-ld:distance_cm",
      "@type": "Property",
      "description": "waste fill in cm",
      "value": {
        "@type": "ngsi-ld:hasValue",
        "@id": "ngsi-ld:Number"
      },
      "unitCode": {
        "@type": "ngsi-ld:unitCode",
        "@id": "ngsi-ld:CMT"
      }
    },
    "location": {
      "@id": "ngsi-ld:location",
      "@type": "GeoProperty",
      "description": "The geographic location of the entity.",
      "value": {
        "@type": "ngsi-ld:hasValue",
        "@id": "geojson:Point"
      }
    },
    "name": {
      "@id": "ngsi-ld:name",
      "@type": "Property",
      "description": "A name for this sensor.",
      "value": {
        "@type": "ngsi-ld:hasValue",
        "@id": "ngsi-ld:String"
      }
    },
    "inactive": {
      "@id": "ngsi-ld:inactive",
      "@type": "Property",
      "description": "Is this sensor active.",
      "value": {
        "@type": "ngsi-ld:hasValue",
        "@id": "ngsi-ld:Boolean"
      }
    }
  }
}
