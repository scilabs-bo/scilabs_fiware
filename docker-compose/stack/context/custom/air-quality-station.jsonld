      },
      "unitCode": {
        "@type": "ngsi-ld:unitCode",
        "@id": "ngsi-ld:GQ"
      }
    },
    "particulateMatter1_0": {
      "@id": "ngsi-ld:particulateMatter1_0",
      "@type": "Property",
      "value": {
        "@type": "ngsi-ld:hasValue",
        "@id": "ngsi-ld:Number"
      },
      "unitCode": {
        "@type": "ngsi-ld:unitCode",
        "@id": "ngsi-ld:GQ"
      }
