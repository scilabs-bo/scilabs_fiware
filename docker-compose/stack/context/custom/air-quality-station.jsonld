        "@id": "ngsi-ld:P1"
      }
    },
    "soundLevel": {
      "@id": "ngsi-ld:soundLevel",
      "@type": "Property",
      "value": {
        "@type": "ngsi-ld:hasValue",
        "@id": "ngsi-ld:Number"
      },
      "unitCode": {
        "@type": "ngsi-ld:unitCode",
