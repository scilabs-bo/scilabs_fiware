      "value": {
        "@type": "ngsi-ld:hasValue",
        "@id": "ngsi-ld:Number"
      },
      "unitCode": {
        "@type": "ngsi-ld:unitCode",
        "@id": "ngsi-ld:GQ"
      }
    },
    "ozone": {
      "@id": "ngsi-ld:ozone",
