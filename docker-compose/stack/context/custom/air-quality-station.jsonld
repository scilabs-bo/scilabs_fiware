    },
    "externalTemperature": {
      "@id": "ngsi-ld:externalTemperature",
      "@type": "Property",
      "value": {
        "@type": "ngsi-ld:hasValue",
        "@id": "ngsi-ld:Number"
      },
      "unitCode": {
        "@type": "ngsi-ld:unitCode",
        "@id": "ngsi-ld:CEL"
      }
    },
    "internalTemperature": {
      "@id": "ngsi-ld:internalTemperature",
      "@type": "Property",
      "value": {
        "@type": "ngsi-ld:hasValue",
        "@id": "ngsi-ld:Number"
      },
      "unitCode": {
        "@type": "ngsi-ld:unitCode",
