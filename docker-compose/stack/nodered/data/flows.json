    {
        "id": "11184efc52df43f6",
        "type": "function",
        "z": "586d6740d3e8f592",
        "name": "Transform data",
        "func": "const host = env.get(\"IOT_AGENT_PROPERTY_POST_URL\");\n\nfunction setBooleanFlag(value) {\n    return value === 'Wert ist gültig';\n}\n\nfunction transformDate(date, time) {\n    const isoDate = date.split('.').reverse().join('-');\n    return new Date(`${isoDate}T${time}`).toISOString();\n}\n\n\nlet parsedData = [];\n\n\n\nlet lines = msg.payload.split(\"\\n\");\nlet meterPoint = lines[2].split(\":\")[1].trim();\n\nlines = lines.slice(10);\n\nfor (const line of lines) {\n    let fields = line.split(\";\");\n\n    if (fields.length < 10) continue;\n\n    let timestamp = transformDate(fields[0].trim(), fields[1].trim());\n\n    parsedData.push({\n        meterPoint,\n        timestamp,\n        activeConsumption: parseFloat(fields[2].replace(\",\", \".\")),\n        statusActiveConsumption: setBooleanFlag(fields[3].trim()),\n        reactiveConsumption: parseFloat(fields[4].replace(\",\", \".\")),\n        statusReactiveConsumption: setBooleanFlag(fields[5].trim()),\n        activeFeed: parseFloat(fields[6].replace(\",\", \".\")),\n        statusActiveFeed: setBooleanFlag(fields[7].trim()),\n        reactiveFeed: parseFloat(fields[8].replace(\",\", \".\")),\n        statusReactiveFeed: setBooleanFlag(fields[9].trim())\n    });\n}\n    \nmsg.url = `${host}?i=LOAD${meterPoint}&k=energyApiKey`;    \nmsg.payload = parsedData;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1120,
        "y": 260,
        "wires": [
            [
                "9e10a20f8809c996",
                "51f104d81da6d214"
            ]
        ]
