    {
        "id": "121e0b8591f0d227",
        "type": "function",
        "z": "e638c5ef3d959148",
        "name": "filter and convert data",
        "func": "const UtmLatLng = global.get('utmLatLng');\nconst utm = new UtmLatLng();\n\nlet validNumbers = [\"10030\", \"10097\", \"10109\"];\nlet host = env.get(\"IOT_AGENT_PROPERTY_POST_URL\");\n\nif (!validNumbers.includes(msg.payload[\"Pegel-Nummer\"])){\n    return null;\n}\n\nlet coords = utm.convertUtmToLatLng(msg.payload.Rechtswert, msg.payload.Hochwert, 32, \"N\");\n\nlet convertedData = {\n    address: msg.payload.Name,\n    levelId: msg.payload[\"Pegel-Nummer\"],\n    name: msg.payload.Fluss,\n    location: {\n        type: \"Point\",\n        coordinates: [coords.lat, coords.lng]\n    },\n    dateWaterLevel: msg.payload.latest_waterlevel.Datum,\n    waterLevel: msg.payload.latest_waterlevel.Wert,\n    waterLevelWarning: msg.payload.latest_waterlevel[\"Aktuelle Warnstufe\"],\n    dateDischarge: msg.payload.latest_discharge.Datum,\n    discharge: msg.payload.latest_discharge.Wert,\n    dischargeWarningLevel: msg.payload.latest_discharge[\"Aktuelle Warnstufe\"] ?? -1,\n    hasCurrentWaterLevel : msg.payload.has_current_waterlevel,\n    hasCurrentDischarge: msg.payload.has_current_discharge\n};\n\nif (!msg.payload.has_current_discharge){\n    convertedData.dateDischarge = undefined;\n    convertedData.discharge = undefined;\n    convertedData.dischargeWarningLevel = undefined;\n}\n\nif (!msg.payload.has_current_waterlevel) {\n    convertedData.dateWaterLevel = undefined;\n    convertedData.waterLevel = undefined;\n    convertedData.waterLevelWarning = undefined;\n}\n\nmsg.payload = convertedData;\nmsg.url = `${host}?i=LEVEL${convertedData.levelId}&k=waterLevelApiKey`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 120,
        "wires": [
            [
                "b7667ba26627123e"
            ]
        ]
    },
